# Homunculus configuration — copy this file to `.env` and fill in values.
# `.env` is gitignored and .dockerignored; it is read by the backend at startup
# and passed into the container via docker-compose `env_file`.

# ── Core: Computer Core (Claude chat) ─────────────────────────────────────
# REQUIRED for the Computer Core. Drives your Claude Pro/Max SUBSCRIPTION (no API
# billing). Generate on a machine with the `claude` CLI logged in:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Optional model override for the Computer Core (sonnet | opus | haiku | full id).
HOMUNCULUS_MODEL=

# ── Remote access / security ──────────────────────────────────────────────
# REQUIRED once reachable beyond localhost (i.e. over Tailscale). Gates the
# WebSocket upgrade AND the sensitive REST routes (crypto). Clients on
# other devices pass it as ?token=... in the URL. Use a long random string.
HOMUNCULUS_TOKEN=

# Admin secret for the audit log's management route (POST /api/audit/annotate).
# Unlike HOMUNCULUS_TOKEN this is NEVER waived for localhost — agents and skills
# run on this machine too, so "local" is not a trust boundary for the record they
# are recorded in. Leave it unset and those routes stay closed (503); the audit
# log itself keeps recording either way. Use a long random string, kept somewhere
# the agents cannot read.
HOMUNCULUS_ADMIN_TOKEN=

# Bind + port. Defaults (0.0.0.0:8787) are correct for Docker; leave unset.
# HOMUNCULUS_HOST=0.0.0.0
# HOMUNCULUS_PORT=8787

# Screener engine interpreter. Normally leave unset: the server probes for a real
# Python at startup (the `py` launcher first on Windows, python3 elsewhere) and
# skips the Microsoft Store alias stub that only prints "Python was not found".
# Set this only to pin a specific interpreter — a venv, or one of several installs.
# SCREENER_PYTHON=

# ── History + Archive tabs + audit log (optional Postgres) ────────────────
# Also backs the append-only audit_log table (see server/auditLog.ts). Leave it
# unset and the audit log still works, writing only to data/audit/*.jsonl.
# Leave blank to run WITHOUT history capture (tabs show live-only, no persistence).
# To enable with the bundled Postgres service:
#   1) pick a password and set POSTGRES_PASSWORD below (compose refuses to start
#      without it — there is deliberately no default to fall back on),
#   2) set DATABASE_URL to match it,
#   3) `docker compose --profile history up -d`
# POSTGRES_PASSWORD=choose-something-long
# DATABASE_URL=postgres://homunculus:<the same password>@db:5432/homunculus
POSTGRES_PASSWORD=
DATABASE_URL=

# ── Crypto tab (Gemini exchange) ──────────────────────────────────────────
# Read-only market data works without keys; portfolio + trading need them.
GEMINI_API_KEY=
GEMINI_API_SECRET=

# ── Crypto tab: CoinMarketCap volume cross-check (optional) ───────────────
# Free API key from coinmarketcap.com/api. Used to cross-check the volume
# gate against aggregated cross-exchange volume (Gemini alone is thin).
# Without it, the volume gate falls back to Gemini-only.
CMC_API_KEY=

# ── Home Assistant tab (optional) ─────────────────────────────────────────
# HA_TOKEN is a long-lived access token (HA → your profile → Security).
# Create it from an ADMIN account. A token inherits the admin status of whoever
# made it, and a non-admin one fails in a genuinely confusing way: reading state,
# controlling lights and running scenes all work perfectly, and only the DEVICES
# tab breaks — Home Assistant gates config flows (adding/removing integrations)
# on admin and answers 401.
HA_URL=
HA_TOKEN=
# HA_POLL_MS=

# ── OSINT tab (optional open-source watchers; all have sane defaults) ─────
OSINT_AISSTREAM_KEY=
# OSINT_PIZZA_URL=
# OSINT_PIZZA_KEY=
# See server/osint.ts for the full list of OSINT_* tuning vars.
